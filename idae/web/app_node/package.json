{
  "name": "app_idae",
  "version": "1.0.0",
  "description": "Idae Legacy Node Server (Modernized)",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "dev": "nodemon src/main.js",
    "logs": "powershell Get-Content ../../../logs/php-error.log -Wait",
    "check:css": "node ../appcss/check-scss-wiring.mjs",
    "build:css": "npm run check:css && sass ../appcss/scss/main.scss ../appcss/dist/main.css --style=compressed --no-source-map && node -e \"require('node:fs').mkdirSync('../appcss/dist/images',{recursive:true});require('node:fs').copyFileSync('../css/images/spinner.gif','../appcss/dist/images/spinner.gif')\"",
    "build:idae-be": "esbuild @medyll/idae-be --bundle --format=iife --global-name=IdaeBe --target=es2017 --sourcemap --outfile=../javascript/vendor/idae-be/idae-be.iife.js",
    "watch:css": "sass --watch ../appcss/scss/main.scss ../appcss/dist/main.css --style=expanded"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "commander": "^14.0.3",
    "cookie": "^1.1.1",
    "cron": "^4.4.0",
    "dotenv": "^17.3.1",
    "mongodb": "^7.1.0",
    "qs": "^6.15.0",
    "express": "^4.18.2",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@medyll/idae-be": "file:D:/development/idae/packages/idae-be",
    "esbuild": "^0.20.0",
    "nodemon": "^3.1.14",
    "sass": "^1.97.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Mydde",
  "license": "ISC"
}
