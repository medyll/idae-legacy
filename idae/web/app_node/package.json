{
  "name": "app_idae",
  "version": "1.0.0",
  "description": "Idae Legacy Node Server (Modernized)",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "dev": "nodemon src/main.js",
    "logs": "powershell Get-Content ../../../logs/php-error.log -Wait",
    "check:css": "node ../appcss/check-scss-wiring.mjs",
    "build:css": "npm run check:css && sass ../appcss/scss/main.scss ../appcss/dist/main.css --style=compressed --no-source-map && node ../appcss/copy-dist-images.mjs",
    "build:idae-be": "esbuild @medyll/idae-be --bundle --format=iife --global-name=IdaeBe --target=es2017 --sourcemap --outfile=../javascript/vendor/idae-be/idae-be.iife.js",
    "watch:css": "sass --watch ../appcss/scss/main.scss ../appcss/dist/main.css --style=expanded"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "commander": "^14.0.3",
    "cookie": "^1.1.1",
    "cron": "^4.4.2",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "mongodb": "^7.9.1",
    "qs": "^6.17.1",
    "socket.io": "^4.8.4",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@medyll/idae-be": "link:..\\..\\..\\..\\idae\\packages\\idae-be",
    "esbuild": "^0.20.2",
    "nodemon": "^3.1.14",
    "sass": "^1.108.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Mydde",
  "license": "ISC"
}
